{
  "name": "montes-de-oca-offroad",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "make:dev-terrain": "node scripts/make-dev-terrain.mjs",
    "test": "npm run typecheck && node scripts/vehicle/assert_heightfield_datum.mjs && node scripts/terrain/validate_terrain.mjs && python3 scripts/roads/validate_roads.py",
    "test:datum": "node scripts/vehicle/assert_heightfield_datum.mjs",
    "test:terrain": "node scripts/terrain/validate_terrain.mjs",
    "test:roads": "python3 scripts/roads/validate_roads.py"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
